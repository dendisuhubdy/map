# Geofabrik region path (e.g. asia/indonesia)
OSM_REGION=north-america/us/california
# Short region slug used in filenames
REGION_SLUG=california
# Photon country-code extract (ISO 3166-1 alpha-2, lowercase)
PHOTON_COUNTRY=us
# Photon is PINNED to the 0.7.x Elasticsearch line: the published country
# extract is an Elasticsearch index and does not load on 1.x/OpenSearch.
# See docs/decisions/photon-index-source.md before changing either value.
PHOTON_VERSION=0.7.4
PHOTON_DUMP_DATE=250720
# Region bounds for DEM tile fetching, as four separate scalars.
# NOT one space-separated variable: quoted, GNU make's `include` keeps the quotes
# in the value; unquoted, `. ./.env` parses field two as a command and drops the
# rest. Four scalars are unambiguous in make, compose, and plain shell sourcing.
REGION_MIN_LON=-124.5
REGION_MIN_LAT=32.5
REGION_MAX_LON=-114.1
REGION_MAX_LAT=42.1
# Absolute path to the block-storage mount
DATA_DIR=/data
# PostGIS
POSTGRES_USER=map
POSTGRES_PASSWORD=changeme
POSTGRES_DB=map
# Public hostname for Caddy TLS
SITE_HOST=twizo.xyz
# Anthropic API key for the Rust agent service (Plan B — unused in Phase 1A).
# Sourced from CLAUDE_MYLOBSTER_KEY on the workstation.
ANTHROPIC_API_KEY=

# --- Plan B: agent service ---
# Anthropic API key for the trip-planning agent. Without it the stack still runs
# and every data service answers, but /api/chat returns 503.
ANTHROPIC_API_KEY=
# Model and reasoning effort for the agent loop.
AGENT_MODEL=claude-opus-5
AGENT_EFFORT=high
